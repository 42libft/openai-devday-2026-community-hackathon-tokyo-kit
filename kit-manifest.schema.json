{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional UI kit manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "preparedAt",
    "adoption",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "preparedAt": {
      "type": "string",
      "format": "date"
    },
    "adoption": {
      "const": "optional-copy-by-component"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "purpose",
          "status",
          "sourceFiles",
          "dependencies",
          "framework",
          "license",
          "preview",
          "importSteps",
          "removal",
          "networkAccess",
          "validated",
          "notValidated"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "candidate",
              "local-prototype",
              "adopted"
            ]
          },
          "sourceFiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "framework": {
            "type": "string"
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "spdx",
              "note"
            ],
            "properties": {
              "status": {
                "enum": [
                  "owner-decision-required",
                  "approved"
                ]
              },
              "spdx": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          },
          "preview": {
            "type": "string"
          },
          "importSteps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "removal": {
            "type": "string"
          },
          "networkAccess": {
            "type": "boolean"
          },
          "validated": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notValidated": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
